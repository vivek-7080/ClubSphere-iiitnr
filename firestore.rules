rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email.lower() == 'kumarvivek802125@gmail.com' ||
        (request.auth.token.email != null && request.auth.token.email.lower() == 'kumarvivek802125@gmail.com')
      );
    }

    // Societies collection
    match /clubs/{clubId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isAuthenticated();
    }

    // Candidate Recruitment Applications
    match /applications/{applicationId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSuperAdmin() || isAuthenticated();
    }

    // Member Rosters
    match /members/{memberId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isAuthenticated();
    }

    // User Profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() || isSuperAdmin();
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
