rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Societies collection - open read and cloud sync for campus directory
    match /clubs/{clubId} {
      allow read, write: if true;
    }

    // Candidate Recruitment Applications
    match /applications/{applicationId} {
      allow read, write: if true;
    }

    // Member Rosters
    match /members/{memberId} {
      allow read, write: if true;
    }

    // User Profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // Notice Board & Event Announcements
    match /announcements/{announcementId} {
      allow read, write: if true;
    }

    // Default test / diagnostics
    match /test/{docId} {
      allow read, write: if true;
    }

    // Catch-all
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
